PORT=8080
OMDB_API_KEY=tu_api_key_de_omdb_aqui

# Firebase Admin (cuenta de servicio). No subir el .env real a Git.
# La PRIVATE_KEY va entre comillas con \n literales.
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=tu_service_account@tu_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
