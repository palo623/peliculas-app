PORT=8080
OMDB_API_KEY=tu_api_key_de_omdb_aqui

# Enriquecimiento automático de temporadas de series (opcional).
# SEASON_ENRICH_ENABLED=false para desactivarlo.
# SEASON_ENRICH_DAILY_LIMIT: tandas diarias para respetar la cuota de OMDb (~1000/día).
# SEASON_ENRICH_HOUR: hora del día en que se lanza la tanda (0-23).
SEASON_ENRICH_ENABLED=true
SEASON_ENRICH_DAILY_LIMIT=25
SEASON_ENRICH_HOUR=4
SEASON_ENRICH_DELAY=300

# Firebase Admin (cuenta de servicio). No subir el .env real a Git.
# La PRIVATE_KEY va entre comillas con \n literales.
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=tu_service_account@tu_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Firebase Web (config pública para Firebase Auth en el front).
# Se consigue en Firebase Console > Configuración del proyecto > Tus apps > App web > firebaseConfig.
# Son obligatorias para registro, login, recuperación y verificación con Firebase Authentication.
FIREBASE_API_KEY=tu_web_api_key
FIREBASE_AUTH_DOMAIN=tu_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=tu_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ---- Vista de administrador (ver docs/ADMIN_API.md) ----

# Emails que reciben rol admin al entrar (separados por comas). Es la forma
# sencilla de crear al primer administrador sin tocar Firestore.
ADMIN_EMAILS=

# Análisis de sentimiento de las reseñas. Por defecto se usa el analizador
# léxico incluido (sin clave, sin coste y sin conexión). Opcionalmente se puede
# conectar una IA real para refinar la clasificación.
SENTIMENT_PROVIDER=auto
# GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=tu_api_key_de_openai
# OPENAI_MODEL=gpt-4o-mini
# SENTIMENT_AI_TIMEOUT_MS=8000

# Modo local forzado para pruebas/CI: no conecta con Firestore aunque haya
# credenciales (lo usa `npm test`).
# DISABLE_FIREBASE=1
